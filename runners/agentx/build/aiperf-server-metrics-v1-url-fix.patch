+            assert not await collector.is_url_reachable()
+
+        assert collector.last_reachability_status == 404
+
+    @pytest.mark.asyncio
+    async def test_configured_url_status_survives_failed_root_probe(self) -> None:
+        """The disabled reason names the configured URL, so it must carry that
+        URL's status rather than the throwaway root probe's."""
+        collector = ServerMetricsDataCollector("http://server:60000/v1/metrics")
+
+        async def fake_check(session) -> bool:
+            if collector._endpoint_url.endswith("/v1/metrics"):
+                collector._last_reachability_status = 503
+                return False
+            collector._last_reachability_status = 404
+            return False
+
+        with patch.object(
+            collector, "_check_reachability_with_session", side_effect=fake_check
+        ):
+            assert not await collector.is_url_reachable()
+
+        assert collector._endpoint_url == "http://server:60000/v1/metrics"
+        assert collector.last_reachability_status == 503
